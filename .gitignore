# Swift / SPM
.build/
.swiftpm/
*.xcodeproj
DerivedData/

# macOS
.DS_Store

# Never commit anything resembling a credential. Keys live in the macOS Keychain
# and are read at runtime — see Secrets.swift for why the ambient
# ANTHROPIC_API_KEY is deliberately ignored.
*.pem
*.p12
.env
.env.*
secrets.json
config.local.json

# Local runtime state (queue, spooled hook payloads, recorded audio, transcripts).
# None of this belongs in the repo; it contains real session content.
/local/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.jsonl
*.wav
*.caf

# Replay corpus. The same rule as above, one step downstream: `*.jsonl` keeps
# corpus.jsonl out, and then 209 run outputs and 7 reports DERIVED from it were
# committed anyway — the harness README describes the source as "full prompts and
# full response body, nothing truncated". The guard existed and did not cover the
# path that mattered. The harness code, the prompts and the summary tables stay;
# the outputs are regenerable from the log by whoever holds the log.
/tools/replay/runs/
/tools/replay/reports/
__pycache__/
*.pyc

# eval output, regenerated by scripts/courtesy-eval.sh
courtesy-eval-results.tsv

# Claude Code harness state (session worktrees live under .claude/worktrees/;
# each is another session's isolated checkout, never this repo's content).
/.claude/
