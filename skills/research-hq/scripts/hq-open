#!/usr/bin/env python3
"""Open a page where it is read now: in the Knowledge Base, never as a file.

    hq-open <page.html>

The page must live under ~/Documents/agents/<session>/...; its hub address is
<app.base_url>/open?session=<session>&slug=<slug>, where slug is the path
under the agent directory with .html dropped and slashes folded (the same
rule as the panel's HubApp and the hub's sender). The panel mirrors a new
page within about twenty seconds, so this waits for the hub to know it
(when a device token is available to ask with), then opens the address.
Ruled 12 Sep 2026: sessions no longer open local files.

It opens in Tranquility Base's Hub window when the app has one, and in the
browser otherwise. Without an app address in ~/.claude/hq.json it opens the
file, as before.
"""
import json, os, subprocess, sys, time, urllib.request

def main():
    if len(sys.argv) != 2:
        sys.exit(__doc__)
    path = os.path.abspath(sys.argv[1])
    root = os.path.expanduser("~/Documents/agents") + "/"
    base = ""
    try:
        base = (json.load(open(os.path.expanduser("~/.claude/hq.json"))).get("app") or {}).get("base_url", "").rstrip("/ ")
    except Exception:
        pass
    if not base.startswith("http") or not path.startswith(root):
        subprocess.run(["open", path])
        print(path)
        return
    rel = path[len(root):]
    session, _, tail = rel.partition("/")
    if tail == "index.html" or not tail:
        url = f"{base}/open?session={session}"
    else:
        slug = tail[:-5] if tail.endswith(".html") else tail
        url = f"{base}/open?session={session}&slug={slug.replace('/', '-')}"
    token = None
    try:
        token = open(os.path.expanduser("~/Library/Application Support/hq/token")).read().strip()
    except Exception:
        pass
    if token:
        deadline = time.time() + 45
        while time.time() < deadline:
            req = urllib.request.Request(url, headers={"Authorization": "Bearer " + token}, method="GET")
            try:
                class NoRedirect(urllib.request.HTTPRedirectHandler):
                    def redirect_request(self, *a, **k): return None
                opener = urllib.request.build_opener(NoRedirect)
                r = opener.open(req, timeout=10)
                code, where = r.getcode(), r.headers.get("Location", "")
            except urllib.error.HTTPError as e:
                code, where = e.code, e.headers.get("Location", "") if e.headers else ""
            except Exception:
                code, where = 0, ""
            # Ready means the redirect goes to the page (/d/<id>). A page the
            # hub does not have yet ALSO redirects, to the agent with
            # ?missing=<slug>; stopping there opened the agent, not the page
            # (found 29 Sep 2026).
            if code in (301, 302, 303, 307, 308) and "/d/" in where:
                break
            time.sleep(4)
    # The app's Hub window first, the browser always as the fallback (29 Sep
    # 2026, hf-o8t.4): the app is the one this script ships inside.
    if in_app(url):
        print(url)
        return
    subprocess.run(["open", url])
    print(url)

def own_app():
    """The app whose Hub window to open: ("path", <bundle>), ("id", <bundle id>) or None.

    First the .app this script sits inside, when it is run from a bundle.
    Since 30 Sep 2026 the app stages its rules into a store outside the bundle
    (.../VoiceDispatch/rules/versions/<fingerprint>/...), so there is usually
    no .app around this file; the running app records which app it is in the
    store's app.json, and that is used instead. Without either (a source
    checkout), the browser is used. Before this, the store copy found no app
    and every page opened in the browser (Robert, 30 Sep).
    """
    here = os.path.realpath(__file__)
    walk = here
    while walk and walk != "/":
        if walk.endswith(".app") and os.path.isdir(os.path.join(walk, "Contents")):
            return ("path", walk)
        walk = os.path.dirname(walk)
    marker = "/rules/versions/"
    if marker in here:
        store = here[:here.index(marker)] + "/rules"
        try:
            with open(os.path.join(store, "app.json")) as fh:
                app = json.load(fh)
        except Exception:
            app = {}
        path = app.get("path") or ""
        if path.endswith(".app") and os.path.isdir(os.path.join(path, "Contents")):
            return ("path", path)
        if app.get("bundle_id"):
            return ("id", app["bundle_id"])
    return None

def in_app(url):
    app = own_app()
    if not app:
        return False
    from urllib.parse import quote
    link = "tranquilitybase://hub?url=" + quote(url, safe="")
    kind, value = app
    args = ["open", "-a", value, link] if kind == "path" else ["open", "-b", value, link]
    return subprocess.run(args).returncode == 0

if __name__ == "__main__":
    main()
