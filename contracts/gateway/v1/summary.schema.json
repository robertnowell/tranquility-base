{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tranquilitybase.dev/contracts/gateway/v1/summary.schema.json",
  "$ref": "#/$defs/request",
  "$defs": {
    "id": {"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "money": {"type":"string","pattern":"^(0|[1-9][0-9]{0,17})$"},
    "source": {
      "type":"object","additionalProperties":false,
      "required":["namespace","taskId","turnId","intentId"],
      "properties": {
        "namespace":{"type":"string","minLength":1,"maxLength":256},
        "taskId":{"type":"string","minLength":1,"maxLength":256},
        "turnId":{"type":"string","minLength":1,"maxLength":256},
        "intentId":{"type":"string","minLength":1,"maxLength":256}
      }
    },
    "input": {
      "type":"object","additionalProperties":false,
      "required":["lastAssistantMessage","projectLabel","hookEvent"],
      "properties": {
        "lastAssistantMessage":{"type":"string","minLength":1,"maxLength":100000,"pattern":"\\S"},
        "projectLabel":{"type":"string","minLength":1,"maxLength":512},
        "firstUserMessage":{"type":"string","maxLength":10000},
        "previousGoal":{"type":"string","maxLength":10000},
        "gitBranch":{"type":"string","maxLength":1024},
        "cwd":{"type":"string","maxLength":4096},
        "hookEvent":{"enum":["Stop","Notification","SubagentStop"]},
        "notificationMatcher":{"type":"string","maxLength":512},
        "earlierThisTurn":{"type":"string","maxLength":6000}
      }
    },
    "request": {
      "type":"object","additionalProperties":false,"required":["version","source","input"],
      "properties":{"version":{"const":"1"},"source":{"$ref":"#/$defs/source"},"input":{"$ref":"#/$defs/input"}}
    },
    "brief": {
      "type":"object","additionalProperties":false,"required":["topic","happened"],
      "properties": {
        "topic":{"type":"string","minLength":1,"maxLength":512},
        "happened":{"type":"string","minLength":1,"maxLength":10000},
        "recap":{"type":"string","maxLength":10000},"proposal":{"type":"string","maxLength":10000},
        "goal":{"type":"string","maxLength":10000},"nextStep":{"type":"string","maxLength":10000},
        "question":{"type":"string","maxLength":10000},"risk":{"type":"string","maxLength":10000},
        "rationale":{"type":"string","maxLength":10000},"findings":{"type":"string","maxLength":10000},
        "solution":{"type":"string","maxLength":10000},"headline":{"type":"string","maxLength":10000},
        "deck":{"type":"string","maxLength":10000},"branch":{"type":"string","maxLength":1024}
      }
    },
    "balance": {
      "type":"object","additionalProperties":false,"required":["availableMicros","reservedMicros","ledgerSequence"],
      "properties":{"availableMicros":{"$ref":"#/$defs/money"},"reservedMicros":{"$ref":"#/$defs/money"},"ledgerSequence":{"$ref":"#/$defs/money"}}
    },
    "receipt": {
      "type":"object","additionalProperties":false,
      "required":["id","accountId","operationId","currency","chargedMicros","pricebookVersion","settledAt","balanceAfter"],
      "properties": {
        "id":{"$ref":"#/$defs/id"},"accountId":{"$ref":"#/$defs/id"},"operationId":{"$ref":"#/$defs/id"},
        "currency":{"const":"USD"},"chargedMicros":{"$ref":"#/$defs/money"},
        "pricebookVersion":{"type":"string","minLength":1,"maxLength":128},
        "settledAt":{"type":"string","format":"date-time"},"balanceAfter":{"$ref":"#/$defs/balance"}
      }
    },
    "error": {
      "type":"object","additionalProperties":false,"required":["code"],
      "properties":{"code":{"enum":["auth_required","forbidden","invalid_request","idempotency_conflict","insufficient_credit","not_found","provider_failed","provider_uncertain","service_unavailable"]}}
    },
    "operation": {
      "type":"object","additionalProperties":false,"required":["version","accountId","operationId","state"],
      "properties": {
        "version":{"const":"1"},"accountId":{"$ref":"#/$defs/id"},"operationId":{"$ref":"#/$defs/id"},
        "state":{"enum":["admitted","running","reconciling","succeeded","failed","cancelled"]},
        "brief":{"$ref":"#/$defs/brief"},"receipt":{"$ref":"#/$defs/receipt"},"error":{"$ref":"#/$defs/error"}
      },
      "allOf": [
        {"if":{"properties":{"state":{"const":"succeeded"}}},"then":{"required":["brief","receipt"],"not":{"required":["error"]}},"else":{"not":{"required":["brief"]}}},
        {"if":{"properties":{"state":{"enum":["admitted","running","reconciling"]}}},"then":{"not":{"required":["receipt"]}}},
        {"if":{"properties":{"state":{"enum":["failed","cancelled"]}}},"then":{"required":["receipt"],"properties":{"receipt":{"properties":{"chargedMicros":{"const":"0"}}}}}}
      ]
    }
  }
}
