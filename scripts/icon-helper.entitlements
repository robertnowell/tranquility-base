<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Temporary only: bundle.sh replaces this signature before output. It lets
       the pre-sign icon renderer load Sparkle while the two are not yet signed
       by the same final identity. The shipped app does not carry this. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
